# What `gcloud run deploy --source .` does NOT upload. Kept identical to
# .dockerignore; tests/test_deploy.py checks both keep the secrets out.
# Without this file gcloud would fall back to .gitignore, which is close
# but not the list the image wants.
.gcloudignore
.git/
.gitignore
.venv/
.env
clude-game-sa.json
data/
legacy/
tests/
docs/
scripts/
.claude/
__pycache__/
*.pyc
.pytest_cache/
desktop.ini
commit_msg.md
requirements.txt
pytest.ini

# Local PNG artwork masters; runtime serves the WebP derivatives.
clude_web/wiki/card_*.png
clude_web/wiki/articles/piece_*.png
clude_web/static/wiki/*.png
